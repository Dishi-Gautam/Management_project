def restaurant_insert():
    import mysql.connector
    myconn=mysql.connector.connect(host='localhost',user='root',passwd=' ',database='hotel')
    cur=myconn.cursor()
    print('-----BELOW IS THE PRICE FOR AN INDIVIDUAL-----')
    print('1. Breakfast: Rs200/-')
    print('2. Lunch/Dinner: Rs350/-')
    n=int(input('Enter your choice: '))
    custid=int(input('Enter Customer ID: '))
    s=int(input('Enter number of persons: '))
    t=int(input('Enter the times meal taken: '))
    if n==1:
        p=200*s*t
        print('Your Bill: ',p)
    elif n==2:
        p=350*s*t
        print('Your Bill: ',p)
    else:
        print('Invalid Input')
    cur.execute('insert into restaurant values("%d","%d","%d")'%(custid,n,t))
    myconn.commit()

