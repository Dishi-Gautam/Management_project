def delete():
    import mysql.connector
   myconn=mysql.connector.connect
   (host='localhost',user='root',passwd=' ',database='hotel')
   cur=myconn.cursor()
   custid=int(input('Enter Customer ID: '))
  print("""1: DELETE FROM CUSTOMER DETAILS2: DELETE FROM   BOOKING\n3: DELETE FROM ROOM_TYPE\n4: DELETE FROM   RESTAURANT\n5: DELETE FROM ROOM_SERVICES\n""")
    ch=int(input("Enter the choice of the table from you want to delete the record:"))
    if ch==1:
        cur.execute('delete from booking_date where Cust_id="%d"'%custid)
        print('Record Deleted')
    elif ch==2:
        cur.execute('delete from roomtype where Cust_id="%d"'%custid)
        print('Record Deleted')
    elif ch==3:
        cur.execute('delete from restaurant where Cust_id="%d"'%custid)
        print('Record Deleted')
    elif ch==4:
        cur.execute('delete from room_services where Cust_id="%d"'%custid)
        print('Record Deleted')
    else:
        print('Invalid Input')
    myconn.commit()
    cur.close()

